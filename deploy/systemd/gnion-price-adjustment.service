[Unit]
Description=Gnion Market automatic product price adjustment
After=network.target mongod.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/ginion-market
Environment=PATH=/home/ubuntu/.nvm/versions/node/v24.21.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/.nvm/versions/node/v24.21.0/bin/npm run prices:adjust

[Install]
WantedBy=multi-user.target
